# MediEvidence Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Server
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Storage & Model Paths
QDRANT_STORAGE_DIR=data/qdrant_storage
PAPERS_DIR=data/papers
METADATA_DIR=data/metadata

# Model Names (sentence-transformers & cross-encoder)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAG Retrieval Hyperparameters
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.35
RRF_K=60
USE_RERANKING=True
